  orderby a.A descending
  orderby a.C ascending
  orderby 1
  select a;

var x = from a in source
  let z = new { a.A, a.B }
  select z;

var x = from a in sourceA
  join b in sourceB on a.FK equals b.PK
  select new { A.A, B.B };

var x = from a in sourceA
  from b in sourceB
  where a.FK == b.FK
  select new { A.A, B.B };

