<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.tarekwasfy01</groupId>
  <artifactId>code-transpiler-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Code Transpiler</name>
  <description>Native Java/Maven bootstrap of Code Transpiler semantic IR and SE/1 projection.</description>
  <url>https://github.com/tarekwasfy01/Code-Transpiler</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Tarek Wasfy</name>
      <url>https://github.com/tarekwasfy01</url>
    </developer>
  </developers>
  <modules><module>transpiler-core</module><module>transpiler-cli</module></modules>
  <properties>
    <revision>0.2.0-SNAPSHOT</revision>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <scm>
    <connection>scm:git:https://github.com/tarekwasfy01/Code-Transpiler.git</connection>
    <developerConnection>scm:git:https://github.com/tarekwasfy01/Code-Transpiler.git</developerConnection>
    <url>https://github.com/tarekwasfy01/Code-Transpiler</url>
  </scm>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/tarekwasfy01/Code-Transpiler</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/tarekwasfy01/Code-Transpiler</url>
    </snapshotRepository>
  </distributionManagement>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
  </plugins></pluginManagement></build>
</project>
